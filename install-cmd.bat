@echo off
rem Register `qwerty` as a global CMD command for the current user.
rem Does NOT require admin. Open a NEW terminal after install.
setlocal EnableExtensions
cd /d "%~dp0"

set "SHIM_DIR=%LOCALAPPDATA%\qwerty-bar"
set "SHIM=%SHIM_DIR%\qwerty.cmd"
set "ROOT=%~dp0"
if "%ROOT:~-1%"=="\" set "ROOT=%ROOT:~0,-1%"

if not exist "%SHIM_DIR%" mkdir "%SHIM_DIR%"

> "%SHIM%" (
  echo @echo off
  echo rem Auto-generated by install-cmd.bat
  echo call "%ROOT%\start.bat" %%*
)

echo.
echo [ok] shim written:
echo     %SHIM%
echo     -^> %ROOT%\start.bat
echo.

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$dir = $env:LOCALAPPDATA + '\qwerty-bar';" ^
  "$userPath = [Environment]::GetEnvironmentVariable('Path','User');" ^
  "if ([string]::IsNullOrEmpty($userPath)) { $parts = @() } else { $parts = $userPath -split ';' | Where-Object { $_ -ne '' } };" ^
  "if ($parts -contains $dir) {" ^
  "  Write-Host '[ok] already on user PATH';" ^
  "} else {" ^
  "  $newPath = if ($parts.Count -eq 0) { $dir } else { ($parts + $dir) -join ';' };" ^
  "  [Environment]::SetEnvironmentVariable('Path', $newPath, 'User');" ^
  "  Write-Host '[ok] added to user PATH:' $dir;" ^
  "}"

echo.
echo Next steps:
echo   1. Close this window and open a NEW cmd / PowerShell
echo   2. Type:  qwerty
echo.
echo To remove later: uninstall-cmd.bat
echo.
pause
